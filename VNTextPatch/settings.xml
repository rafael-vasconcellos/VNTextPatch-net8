<?xml version="1.0" encoding="utf-8"?>
<settings>
  <!-- When using an API key to access Google spreadsheets -->
  <GoogleApiKey></GoogleApiKey>

  <!-- Instead of using an API key, you can also use a service account.
       This way, you don't have to make your spreadsheet public. -->
  <!-- To use a service account, download its private key
       and store it in a file called "google-service-account.json". -->

  <MonospaceCharactersPerLine>50</MonospaceCharactersPerLine>

  <ProportionalFontName>Franklin Gothic Book</ProportionalFontName>
  <ProportionalFontSize>40</ProportionalFontSize>
  <ProportionalFontBold>false</ProportionalFontBold>
  <ProportionalLineWidth>1000</ProportionalLineWidth>
  <SecondaryProportionalLineWidth>670</SecondaryProportionalLineWidth>
</settings>
